# Copier ce fichier en .env et renseigner les valeurs. Ne jamais committer .env.

# Port d'écoute du service
PORT=3000

# Jeton d'accès permanent (utilisateur système Meta Business)
WHATSAPP_TOKEN=

# Phone Number ID fourni par Meta (WhatsApp > Configuration de l'API)
WHATSAPP_PHONE_NUMBER_ID=

# Clé secrète partagée avec l'application Android (en-tête x-api-key)
SERVICE_API_KEY=

# Noms et langue des modèles approuvés par Meta
TEMPLATE_PAYMENT=confirmation_paiement
TEMPLATE_LATE=relance_retard
TEMPLATE_LANG=fr

# Version de l'API Graph
GRAPH_VERSION=v23.0
